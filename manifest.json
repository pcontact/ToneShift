{
  "manifest_version": 3,
  "name": "ToneShift",
  "description": "Adapt web content dynamically: tone, complexity, brevity.",
  "version": "0.1",
  "permissions": ["scripting", "storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "popup.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["pageGemini.js", "pageGeminiLoader.js", "pageHybrid.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
