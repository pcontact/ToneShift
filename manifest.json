{
  "manifest_version": 3,
  "name": "ToneShift",
  "description": "Adapt web content dynamically: tone, complexity, brevity.",
  "version": "0.1",
  "permissions": ["scripting", "storage", "activeTab"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "background.js",
    "type":"module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "type":"module"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "popup.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pageGemini.js",
        "pageGeminiLoader.js",
        "pageHybrid.js",
        "utils/readabilityHelpers.js",
        "utils/extractMainText.js",
        "utils/getRewriteContext.js",
        "libs/Readability.js",
        "../pageHybrid",
        "chatPanel.js",
        "utils/helpers.js",
        "searchModule.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
