{
  "manifest_version": 3,
  "name": "ToneShift",
  "description": "Refine web content dynamically.",
  "version": "0.1",
  "permissions": ["offscreen", "contextMenus", "scripting", "storage", "activeTab"],
  "minimum_chrome_version": "138",
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "background/index.js",
    "type":"module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "type":"module",
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "popup.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pageHybrid.js",
        "utils/extractMainText.js",
        "utils/getRewriteContext.js",
        "chatPanel.js",
        "utils/helpers.js",
        "utils/universal_gemini_router.js",
        "local_ai/gemini_local.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
